{
  "categories": [
    {
      "title": "## ✨ Features",
      "labels": [],
      "rules": [{ "pattern": "^feat(\\(.*\\))?!?:", "on_property": "title", "flags": "gim" }]
    },
    {
      "title": "## 🐛 Bug Fixes",
      "labels": [],
      "rules": [{ "pattern": "^fix(\\(.*\\))?!?:", "on_property": "title", "flags": "gim" }]
    },
    {
      "title": "## ⚡ Performance",
      "labels": [],
      "rules": [{ "pattern": "^perf(\\(.*\\))?!?:", "on_property": "title", "flags": "gim" }]
    },
    {
      "title": "## ♻️ Refactoring",
      "labels": [],
      "rules": [{ "pattern": "^refactor(\\(.*\\))?!?:", "on_property": "title", "flags": "gim" }]
    },
    {
      "title": "## 🔧 Chores & Maintenance",
      "labels": [],
      "rules": [
        {
          "pattern": "^(chore|build|ci|docs|style|test)(\\(.*\\))?!?:",
          "on_property": "title",
          "flags": "gim"
        }
      ]
    },
    {
      "title": "## 📦 Other Changes",
      "labels": [],
      "rules": [{ "pattern": ".*", "on_property": "title", "flags": "gim" }]
    }
  ],
  "template": "#{{CHANGELOG}}\n\n---\n\n**Full Changelog**: #{{RELEASE_DIFF}}\n\n> Download the installer for your platform from the Assets below.",
  "category_template": "#{{TITLE}}\n\n#{{CHANGELOG}}",
  "pr_template": "- #{{TITLE}} (#{{MERGE_SHA}})",
  "empty_template": "- No notable changes",
  "commit_template": "- #{{TITLE}}",
  "trim_values": true
}
